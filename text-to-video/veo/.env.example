# Template — copy to .env.local and fill in your values there.
# Do not put real credentials in this file; it is tracked in git.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Caps how much this script will spend in a rolling 10-minute window before it
# refuses to send another request. Defaults to $10.00, the Gemini API's Tier 1
# spend-based rate limit. Raise it if your project is on a higher tier.
# VEO_SPEND_LIMIT_USD=10.00

# Caps how many Veo requests will be sent per day before the script refuses.
# Defaults to 10, the Tier 1 limit. Resets at midnight Pacific.
# VEO_DAILY_REQUEST_LIMIT=10
